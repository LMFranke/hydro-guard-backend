# ============================================================================
# HYDROGUARD BACK-END — VARIÁVEIS DE AMBIENTE (TEMPLATE)
# Copie este arquivo para .env (ou configure na sua IDE / servidor)
# NUNCA versione o arquivo .env real no Git.
# ============================================================================

# Conexão PostgreSQL / Supabase
DATABASE_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:6543/postgres?prepareThreshold=0
DATABASE_USER=postgres.seu_projeto_id
DATABASE_PASSWORD=sua_senha_do_banco_aqui

# Segredo criptográfico para assinatura de tokens JWT (Obrigatório, sem fallback no código)
JWT_SECRET=defina_uma_chave_secreta_aleatoria_com_pelo_menos_32_caracteres

# Credenciais do Webservice HidroWeb / Agência Nacional de Águas (ANA)
ANA_IDENTIFIER=seu_identificador_ana
ANA_PASSWORD=sua_senha_ana